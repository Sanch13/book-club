# Скопируйте в .env и заполните. Сам .env в git не попадает.
#
#   cp .env.example .env
#
# Обязательные значения — без них compose не стартует (проверка через ${...?}).

# Ключ Django. Сгенерировать новый:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Значение ниже — только для примера, НЕ используйте его в бою.
DJANGO_SECRET_KEY=замените-на-случайную-строку-минимум-50-символов

# Хост, на котором приложение отвечает. Это адрес ВНУТРИ сети — тот, по
# которому к нему обращается Nginx Proxy Manager.
DJANGO_ALLOWED_HOSTS=book-club.internal

# Публичный адрес, который видит браузер. Именно его Django сверяет с
# Origin/Referer при проверке CSRF. Со схемой https и без слеша.
DJANGO_CSRF_TRUSTED_ORIGINS=https://book-club.miran.local

# Предельный размер загружаемого файла, МБ. Должен совпадать с
# client_max_body_size в nginx/nginx.conf, иначе одно из двух звеньев
# обрежет файл раньше и выдаст 413.
MAX_UPLOAD_SIZE_MB=200
